# Copy to .env and fill in your Binance DEMO credentials. Never commit .env.
# Keys are created in the Binance demo environment:
#   https://demo.binance.com/en/my/settings/api-management

# --- credentials (demo / paper only) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- base URLs (demo defaults; all paper, no real money) ---
# Spot demo:    https://demo-api.binance.com
# Futures demo: https://demo-fapi.binance.com   (USDⓈ-M perp hedging)
SPOT_BASE=https://demo-api.binance.com
FUTURES_BASE=https://demo-fapi.binance.com

# --- what & how to hedge ---
SYMBOL=BTCUSDT
PORT=8787

# --- SAFETY ---
# DRY_RUN=true  -> never sends orders, only logs intended hedges (default).
# Set to false ONLY when you are ready to place real DEMO orders.
DRY_RUN=true
# Hedger runs only when enabled (also toggleable at runtime via the API).
HEDGE_ENABLED=false
# Hedge notional budget (USDT) — the BTC cap is maxNotional/markPrice. ~the full 10k.
MAX_NOTIONAL_USDT=10000
# (legacy, unused once MAX_NOTIONAL_USDT is set)
MAX_POSITION_BTC=0.05
# Reconcile the hedge at most this often (seconds).
HEDGE_INTERVAL_SEC=10
# Hedge target: 'delta' (neutralise the skew) | 'sentiment' (perp ∝ smart-money
# lean) | 'combined' (delta hedge + sentiment tilt). Toggleable at runtime.
HEDGE_MODE=combined
# At sentiment lean = ±1, hold SENTIMENT_GAIN × MAX_POSITION_BTC.
SENTIMENT_GAIN=1
# --- Volatility gate -------------------------------------------------------
# Only hedge when realized vol is high enough that the protection out-earns the
# round-trip fee cost; flatten when calm (avoids fee bleed). Calibrate the
# threshold from the live `realizedVol` shown on the 5m page / Live tab.
# OFF by default: live 1s BTC realizedVol ~4e-5 is too flat for a usable absolute
# threshold — the INVENTORY gate does the work. Turn on only for a volatile run.
HEDGE_VOL_GATE=false
HEDGE_VOL_WINDOW=60
# turn hedging ON when per-tick return stdev ≥ this (tune live from the 5m page)
HEDGE_VOL_THRESHOLD=0.0002
# stay ON until vol falls below THRESHOLD × this (hysteresis, prevents flapping)
HEDGE_VOL_HYSTERESIS=0.6
# --- Inventory gate + risk-tier --------------------------------------------
# The live hedger fires only when BOTH gates are open: vol (above) AND inventory
# (here). Below this notional exposure (|aggregate δ|×spot, USDT) the hedge stays
# flat — little is at risk, so don't pay fees. Above it the risk-tier ramps the
# hedge (tierLow → tierHigh → full). RECALIBRATE to the live `notionalUsdt` shown
# on the 5m page before turning DRY_RUN off (simulated flow ≠ live magnitudes).
HEDGE_NOTIONAL_USDT=80
# Gate mode: 'adaptive' (default) self-calibrates the inventory gate to a
# percentile of the last hour's exposure (floored at HEDGE_NOTIONAL_USDT), so it
# keeps discriminating as flow/BTC level drift. 'fixed' = absolute threshold.
HEDGE_GATE_MODE=adaptive
HEDGE_GATE_PCTL=0.6
HEDGE_TIER_LOW=0.3
HEDGE_TIER_HIGH=0.7
# Perp leverage for the hedge (1x = no leverage; a hedge wants none). Changeable
# live from the 5m page dropdown.
HEDGE_LEVERAGE=1
# Multi-Assets Mode: USDC + USDT together back the BTCUSDT hedge (~10k). Set
# false to margin from USDT only (~5k). Can't toggle with an open position.
MULTI_ASSETS_MARGIN=true
# NOTE: keep MAX_NOTIONAL_USDT ≤ your demo futures wallet, else a full-size
# (risk-tier=1.0) hedge can exceed margin and the order rejects.
# Stale-feed guard: freeze market time (no settlements) if Binance hasn't
# answered for this many seconds; resumes on recovery.
FEED_STALE_SEC=15

# Rebalance deadband (USDT): skip hedge trades smaller than this to avoid fee
# churn from tiny target wobbles. Must be >= the $50 min-notional.
HEDGE_DEADBAND_USDT=75
